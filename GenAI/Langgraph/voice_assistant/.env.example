GROQ_API_KEY=your_groq_api_key_here
# Tool-use fine-tuned model — most reliable for function calling on Groq
# Alternatives: llama-3.1-70b-versatile | llama3-70b-8192
GROQ_MODEL=llama3-groq-70b-8192-tool-use-preview

ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Max messages kept in context per session (human + AI, each turn = 2).
# 20 = last 10 exchanges. Lower if hitting Groq token limit errors.
MAX_HISTORY_MESSAGES=20

# PostgreSQL — enables persistent conversation memory across restarts.
# Format: postgresql://user:password@host:port/dbname
# Leave empty to use in-memory sessions (history lost on restart).
DATABASE_URL=postgresql://postgres:password@localhost:5432/cortexai
